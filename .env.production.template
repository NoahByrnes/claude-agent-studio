# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy these to the appropriate services
# =============================================================================

# -----------------------------------------------------------------------------
# RAILWAY - Backend API Service
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://studio.noahbyrnes.com

# Supabase (get from: https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database (get from: Supabase → Settings → Database → Connection string → URI)
# IMPORTANT: Use port 6543 for connection pooling
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:6543/postgres?pgbouncer=true

# Redis (get from: Railway Redis service → Variables)
REDIS_URL=redis://default:[password]@[host]:6379

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# -----------------------------------------------------------------------------
# RAILWAY - Agent Worker Service
# -----------------------------------------------------------------------------
# Copy ALL variables from Backend API above, PLUS:

BACKEND_URL=https://your-backend-api.railway.app
# Or if using custom domain:
# BACKEND_URL=https://api-studio.noahbyrnes.com

# -----------------------------------------------------------------------------
# VERCEL - Frontend
# -----------------------------------------------------------------------------
# Note: Use VITE_ prefix for Vite environment variables

VITE_API_BASE=https://api-studio.noahbyrnes.com
# Or if not using custom domain yet:
# VITE_API_BASE=https://your-backend-api.railway.app/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# NOTES:
# - Never commit this file with real values!
# - Service role key is SECRET - only use in backend
# - Anon key is PUBLIC - safe to use in frontend
# - Make sure CORS_ORIGIN matches your frontend domain exactly
# =============================================================================
